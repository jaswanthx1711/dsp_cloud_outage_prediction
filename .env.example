# Application database
DATABASE_URL=postgresql://postgres:yourpassword@db:5432/dsp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=dsp

# Airflow metadata database
AIRFLOW_DB_URL=postgresql+psycopg2://airflow:airflow@airflow-db:5432/airflow

# Airflow Fernet key (encrypt connection passwords in the DB)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here

# Airflow Webserver secret key (required in Airflow 3 for session signing)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=your_secret_key_here

# Microsoft Teams Webhook — Data Quality Alerts channel (optional – leave empty to skip alerts)
TEAMS_WEBHOOK_URL=

# Microsoft Teams Webhook — ML Alerts channel (drift / promotion failures, optional)
ML_ALERTS_TEAMS_WEBHOOK_URL=

# MLflow model registry (Defense 2)
MODEL_NAME=cloud_outage_duration

# Training DAG promotion criteria
# RMSE_PROMOTION_THRESHOLD: leave empty to require candidate RMSE <= champion RMSE (relative).
# Set a number to also require candidate RMSE below this absolute ceiling.
RMSE_PROMOTION_THRESHOLD=
INFERENCE_MS_THRESHOLD=50
MIN_NEW_ROWS_FOR_TRAINING=50

# Grafana admin password (change for anything beyond local demo use)
GRAFANA_ADMIN_PASSWORD=admin
