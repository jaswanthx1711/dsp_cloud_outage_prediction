airflow_logs/

# Pytest cache
.pytest_cache/

# Model file (regenerated on startup)
data/model.pkl

# Airflow Simple Auth Manager credentials (generated at init, contains admin password)
data/passwords.json

# MLflow local artifact store
mlflow-artifacts/
mlartifacts/

# Prediction job tracker state
data/.last_prediction_timestamp
