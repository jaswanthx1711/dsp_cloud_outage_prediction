.env
__pycache__/
**/__pycache__/
*.pyc
*.pkl
.DS_Store
.venv/

# Data folders (generated/runtime)
data/raw_data/
data/good_data/
data/bad_data/
data/archived_data/

# Great Expectations runtime artifacts (keep gx/ committed for config)
gx/uncommitted/
